#!/usr/bin/env python3
"""MU-TH-UR 6000 console. Ask about the vessel (this computer) in plain words.
Python standard library only. Type HELP for inquiries, EXIT to log off."""
import datetime
import os
import random
import re
import shutil
import socket
import subprocess
import sys
import time
from pathlib import Path

THEME = Path.home() / '.config/omarchy/themes/lv-426'
GREEN, BRIGHT, AMBER, RED, DIM, RESET = (
    '\033[32m', '\033[92m', '\033[33m', '\033[31m', '\033[2;32m', '\033[0m')
QUIET = '--quiet' in sys.argv


def chirp(name='mother.wav', volume='0.3'):
    if QUIET or not shutil.which('pw-play'):
        return
    subprocess.Popen(['pw-play', '--volume', volume, str(THEME / 'sounds' / name)],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def teletype(text, color=GREEN, delay=0.012):
    sys.stdout.write(color)
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        if ch != ' ':
            time.sleep(delay)
    sys.stdout.write(RESET + '\n')


def answer(lines, color=GREEN):
    chirp()
    time.sleep(0.25)
    for line in lines:
        teletype(line.upper(), color)
    print()


def read(path, default=''):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


# ---- vessel telemetry -------------------------------------------------------

def cpu_load():
    def snap():
        f = list(map(int, read('/proc/stat').splitlines()[0].split()[1:]))
        return f[3] + f[4], sum(f)
    i1, t1 = snap(); time.sleep(0.4); i2, t2 = snap()
    return 0 if t2 == t1 else 1 - (i2 - i1) / (t2 - t1)


def mem():
    info = dict(re.findall(r'^(\w+):\s+(\d+)', read('/proc/meminfo'), re.M))
    total, avail = int(info.get('MemTotal', 1)), int(info.get('MemAvailable', 0))
    return (total - avail) / total, total / 1048576


def uptime():
    secs = int(float(read('/proc/uptime', '0').split()[0]))
    d, rem = divmod(secs, 86400)
    h, m = rem // 3600, rem % 3600 // 60
    return f'{d}D {h:02}H {m:02}M' if d else f'{h:02}H {m:02}M'


def battery():
    for bat in sorted(Path('/sys/class/power_supply').glob('BAT*')):
        cap = read(bat / 'capacity', '?')
        status = read(bat / 'status', 'Unknown')
        return cap, status
    return None, None


def temperature():
    temps = []
    for zone in Path('/sys/class/thermal').glob('thermal_zone*'):
        t = read(zone / 'temp')
        if t.isdigit():
            temps.append(int(t) / 1000)
    return max(temps) if temps else None


def network():
    try:
        out = subprocess.run(['ip', '-4', '-o', 'addr', 'show', 'scope', 'global'],
                             capture_output=True, text=True, timeout=2).stdout
        links = [(l.split()[1], l.split()[3]) for l in out.splitlines()]
    except (OSError, subprocess.SubprocessError):
        links = []
    return links


# ---- inquiries -----------------------------------------------------------------

def q_help():
    answer(['AVAILABLE INQUIRIES:',
            '  STATUS        VESSEL SYSTEMS REPORT',
            '  POWER         ENERGY RESERVES',
            '  TRACKER       MOTION TRACKER READING',
            '  CREW          CREW MANIFEST',
            '  SIGNAL        COMMUNICATIONS ARRAY',
            '  TIME          SHIP CHRONOMETER',
            '  WEATHER       PLANETARY CONDITIONS',
            '  ORDERS        COMPANY DIRECTIVES',
            '  CHANCES       SURVIVAL ESTIMATE',
            '  DESTRUCT      EMERGENCY DESTRUCT SYSTEM',
            '  CLEAR / EXIT'])


def q_status():
    load, (used, total) = cpu_load(), mem()
    t = temperature()
    lines = [f'VESSEL ........ {socket.gethostname()}',
             f'KERNEL ........ {os.uname().release}',
             f'REACTOR LOAD .. {load * 100:5.1f}%',
             f'LIFE SUPPORT .. {used * 100:5.1f}% OF {total:.1f} GB',
             f'TIME UNDERWAY . {uptime()}']
    if t is not None:
        lines.append(f'CORE TEMP ..... {t:5.1f} C')
    hot = load > 0.85 or used > 0.9 or (t or 0) > 90
    lines.append('ALL SYSTEMS NOMINAL.' if not hot else 'WARNING: SYSTEMS UNDER STRAIN.')
    answer(lines, AMBER if hot else GREEN)


def q_power():
    cap, status = battery()
    if cap is None:
        answer(['VESSEL RUNNING ON EXTERNAL POWER. NO RESERVE CELLS DETECTED.'])
        return
    low = cap.isdigit() and int(cap) < 20 and status != 'Charging'
    answer([f'RESERVE CELLS AT {cap}%. STATUS: {status}.',
            'RECOMMEND IMMEDIATE CONNECTION TO SHORE POWER.' if low else 'RESERVES ADEQUATE.'],
           RED if low else GREEN)


def q_tracker():
    load = cpu_load()
    meters = 1 + 29 * (1 - load) ** 1.6
    color = RED if meters < 5 else AMBER if meters < 12 else GREEN
    verdict = ('THEY ARE IN THE ROOM.' if meters < 5 else
               'MOVEMENT CLOSING.' if meters < 12 else 'NO IMMEDIATE THREAT.')
    answer([f'CONTACT AT {meters:.1f} METERS.', verdict], color)


def q_crew():
    try:
        out = subprocess.run(['who'], capture_output=True, text=True, timeout=2).stdout
        crew = sorted({l.split()[0] for l in out.splitlines() if l.strip()})
    except (OSError, subprocess.SubprocessError):
        crew = []
    crew = crew or [os.environ.get('USER', 'UNKNOWN')]
    answer(['CREW MANIFEST:'] + [f'  {c}  ....  AWAKE' for c in crew] +
           ['  JONES (CAT) ....  UNACCOUNTED FOR'])


def q_signal():
    links = network()
    if not links:
        answer(['NO TRANSMISSION ARRAY ONLINE. VESSEL IS DARK.'], AMBER)
        return
    answer(['COMMUNICATIONS ARRAY:'] + [f'  {dev:<10} {addr}' for dev, addr in links] +
           ['UNKNOWN TRANSMISSION DETECTED. DECIPHERING.'])


def q_time():
    now = datetime.datetime.now()
    answer([f'SHIP TIME {now:%H:%M:%S}. EARTH DATE {now:%Y-%m-%d}.',
            f'{2122 - now.year} YEARS UNTIL THE NOSTROMO INTERCEPTS THE SIGNAL.'])


def q_weather():
    answer(['LV-426 SURFACE: WIND 160 KM/H. VISIBILITY NIL.',
            'ATMOSPHERE: PRIMORDIAL. NITROGEN, INERT GASES. NOT BREATHABLE.',
            'RECOMMEND REMAINING ABOARD.'])


def q_orders():
    answer(['SPECIAL ORDER 937', 'SCIENCE OFFICER EYES ONLY', '',
            'PRIORITY ONE: INSURE RETURN OF ORGANISM FOR ANALYSIS.',
            'ALL OTHER CONSIDERATIONS SECONDARY.',
            'CREW EXPENDABLE.'], AMBER)


def q_chances():
    answer(['DOES NOT COMPUTE.'])


def q_clarify():
    answer(['UNABLE TO CLARIFY.'])


def q_destruct():
    chirp('klaxon.wav', '0.45')
    teletype('EMERGENCY DESTRUCT SYSTEM ACTIVATED.', RED)
    teletype('THE OPTION TO OVERRIDE AUTOMATIC DETONATION EXPIRES IN T-MINUS 10.', RED)
    try:
        for n in range(10, 0, -1):
            sys.stdout.write(f'\r{RED}T-MINUS {n:02}  ::  PRESS CTRL+C TO OVERRIDE {RESET}')
            sys.stdout.flush()
            time.sleep(1)
        print()
        answer(['DETONATION SEQUENCE COMPLETE.',
                '...',
                'JUST KIDDING. THIS IS A LAPTOP. HAVE A NICE DAY.'], AMBER)
    except KeyboardInterrupt:
        print()
        answer(['OVERRIDE ACCEPTED. DESTRUCT SEQUENCE ABORTED.'])


def q_mother():
    answer(['YES?'])


def q_unknown(_query):
    answer([random.choice([
        'QUERY NOT UNDERSTOOD. REPHRASE.',
        'INSUFFICIENT DATA.',
        'ACCESS RESTRICTED. SCIENCE OFFICER EYES ONLY.',
        'REQUEST NOT IN COMPANY PROTOCOL.',
    ]), 'TYPE HELP FOR AVAILABLE INQUIRIES.'], DIM)


ROUTES = [
    (r'\b(help|\?|commands?)\b', q_help),
    (r'\b(orders?|937|directive|company|weyland)', q_orders),
    (r'\b(chance|odds|survive|survival)', q_chances),
    (r'\b(clarify|neutrali[sz]e|science)', q_clarify),
    (r'\b(destruct|detonat|self.destruct|self destruct)', q_destruct),
    (r'\b(status|system|systems|report|diagnostic)', q_status),
    (r'\b(power|battery|reserve|energy)', q_power),
    (r'\b(tracker|motion|contact|alien|xeno|creature|organism)', q_tracker),
    (r'\b(crew|manifest|who|cat|jones)\b', q_crew),
    (r'\b(signal|network|transmission|comms?|ip)\b', q_signal),
    (r'\b(time|date|clock|chronometer)\b', q_time),
    (r'\b(weather|planet|atmosphere|surface|lv-?426)', q_weather),
    (r'^\s*(mother|mu-?th-?ur)\s*\??\s*$', q_mother),
]


def banner():
    os.system('clear')
    w = min(shutil.get_terminal_size().columns, 64)
    print(BRIGHT + '═' * w)
    print(' MU-TH-UR 6000'.ljust(w - 22) + 'WEYLAND-YUTANI CORP')
    print('═' * w + RESET)
    teletype('INTERFACE 2037 READY FOR INQUIRY', GREEN, 0.03)
    print(DIM + 'TYPE HELP FOR AVAILABLE INQUIRIES. EXIT TO LOG OFF.' + RESET + '\n')


def main():
    banner()
    chirp()
    while True:
        try:
            query = input(BRIGHT + '> ' + RESET).strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not query:
            continue
        low = query.lower()
        if re.fullmatch(r'(exit|quit|bye|logout|log off|q)', low):
            break
        if low in ('clear', 'cls'):
            banner()
            continue
        for pattern, fn in ROUTES:
            if re.search(pattern, low):
                fn()
                break
        else:
            q_unknown(query)
    teletype('INTERFACE TERMINATED.', DIM, 0.02)
    time.sleep(0.4)


if __name__ == '__main__':
    main()
